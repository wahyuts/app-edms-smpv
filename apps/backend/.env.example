############################################################
# APPLICATION
############################################################

APP_NAME=EDMS Backend
APP_VERSION=1.0.0
APP_ENV=development

############################################################
# SERVER
############################################################

PORT=4000

############################################################
# DATABASE — MYSQL
############################################################

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=edms_smpv_dev
MYSQL_USER=root
MYSQL_PASSWORD=

############################################################
# AUTHENTICATION & SECURITY
############################################################

JWT_SECRET=ISI_DENGAN_SECRET_YANG_AMAN
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Local development:
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# Railway Development/UAT/Staging with frontend on localhost:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# CORS_ALLOWED_ORIGINS=https://edms-staging.vercel.app

# Productions beda domain:
# contoh Frontend: https://edms.beta-int-modernergy.com
# Backend : https://backend-production.up.railway.app
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# CORS_ALLOWED_ORIGINS=https://edms.beta-int-modernergy.com

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

############################################################
# EMAIL
############################################################

EMAIL_PROVIDER=dummy / resend (pilih salah satu)
EMAIL_FROM=EDMS Notification <info@beta-int-modernergy.com>
RESEND_API_KEY=
ENABLE_DEV_EMAIL_OUTBOX=true
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password

############################################################
# CORS
############################################################

# Pisahkan beberapa origin menggunakan koma tanpa spasi.
# Contoh: http://localhost:5173,https://staging-edms.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

############################################################
# FILE STORAGE
############################################################

# Nilai yang direncanakan:
# - local  : local filesystem / Railway Volume
# - r2     : Cloudflare R2 untuk production
STORAGE_DRIVER=local

# Dipertahankan agar kompatibel dengan implementasi backend saat ini.
# Local development example : ./storage
# Railway Volume example    : /data/edms-storage
STORAGE_PATH=./storage

############################################################
# CLOUDFLARE R2
# Wajib diisi hanya ketika STORAGE_DRIVER=r2.
############################################################

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto

## DIBAWAH INI SETUP R2 UNTUK DEVELOPMENT
R2_ACCOUNT_ID=28eb9ffe3e5848e4bcf758dd3510053e
R2_BUCKET_NAME=app-edms-smpv-development
R2_ACCESS_KEY_ID=216297aeca8511517a4c9dd56ddb474d
R2_SECRET_ACCESS_KEY=0aa18512b6c13cc37398f472a3bd0c77e43a14f2d2480b898ff6ec93f8437b46
R2_ENDPOINT=https://28eb9ffe3e5848e4bcf758dd3510053e.r2.cloudflarestorage.com
R2_REGION=auto


## DIBAWAH INI SETUP R2 UNTUK STAGING
R2_ACCOUNT_ID=26f91676caf391d1381dd80b7ab547b6
R2_BUCKET_NAME=app-edms-smpv-staging
R2_ACCESS_KEY_ID=561a3df4e0aeb5c24f114a18d9373c7a
R2_SECRET_ACCESS_KEY=5d8ef6244795953bb94bb2f052430251f5952dbeed9fa0b959a21779d38659ec
R2_ENDPOINT=https://26f91676caf391d1381dd80b7ab547b6.r2.cloudflarestorage.com
R2_REGION=auto

############################################################
# OPTIONAL PUBLIC / SIGNED FILE URL CONFIGURATION
############################################################

# Kosongkan apabila file hanya diakses melalui signed URL dari backend.
R2_PUBLIC_BASE_URL=

############################################################
# UPLOAD PIPELINE
############################################################

# Default: 25 MB.
UPLOAD_MAX_FILE_SIZE_BYTES=26214400

# Default: 24 hours.
UPLOAD_TEMPORARY_TTL_HOURS=24

############################################################
# SLA NOTIFICATION PRODUCER
############################################################

# Scheduler internal bersifat opt-in.
# Aktifkan hanya pada environment yang memang memakai backend always-on.
SLA_NOTIFICATION_SCHEDULER_ENABLED=false

# Interval evaluasi scheduler internal dalam millisecond.
# 60000 = 1 menit.
SLA_NOTIFICATION_SCHEDULER_INTERVAL_MS=60000

# Maksimal dokumen aktif yang dievaluasi dalam satu batch.
SLA_NOTIFICATION_BATCH_SIZE=200

# WAJIB jika endpoint internal scheduled job digunakan.
# Jangan isi secret nyata di repository.
# Cara membuat token:ketik di terminal bash node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLA_NOTIFICATION_JOB_TOKEN=

# Local development biasa
SLA_NOTIFICATION_SCHEDULER_ENABLED=false
SLA_NOTIFICATION_SCHEDULER_INTERVAL_MS=60000
SLA_NOTIFICATION_BATCH_SIZE=200
SLA_NOTIFICATION_JOB_TOKEN=<secret-panjang-acak>

# Railway development dengan Serverless/Sleep
SLA_NOTIFICATION_SCHEDULER_ENABLED=false
SLA_NOTIFICATION_SCHEDULER_INTERVAL_MS=60000
SLA_NOTIFICATION_BATCH_SIZE=200
SLA_NOTIFICATION_JOB_TOKEN=<secret-panjang-acak>

# Production always-on satu instance
SLA_NOTIFICATION_SCHEDULER_ENABLED=true
SLA_NOTIFICATION_SCHEDULER_INTERVAL_MS=60000
SLA_NOTIFICATION_BATCH_SIZE=200
SLA_NOTIFICATION_JOB_TOKEN=<secret-panjang-acak>
