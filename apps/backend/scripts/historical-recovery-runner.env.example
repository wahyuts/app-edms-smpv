# Copy manually to tmp/historical-binding/<environment>/.env. Never use backend .env.
APP_ENV=development
# TCP_PROXY (default): strict MySQL TLS. SSH_TUNNEL: managed authenticated SSH.
MYSQL_TRANSPORT=TCP_PROXY
MYSQL_HOST=YOUR_PUBLIC_TCP_PROXY_HOST
MYSQL_PORT=YOUR_PUBLIC_TCP_PROXY_PORT
MYSQL_DATABASE=YOUR_SCHEMA
MYSQL_USER=YOUR_USER
MYSQL_PASSWORD=YOUR_PASSWORD
# CA must be obtained through a trusted owner-controlled channel, not an unverified handshake.
MYSQL_TLS_MODE=VERIFY_IDENTITY
MYSQL_TLS_CA_FILE=D:/PRIVATE_CERTIFICATES/mysql-ca.pem
# Must equal MYSQL_HOST AND match a DNS SAN in the actual MySQL server certificate.
# Do not copy the proxy hostname here without verifying its certificate identity.
MYSQL_TLS_SERVER_NAME=YOUR_VERIFIED_PUBLIC_TCP_HOST
# For SSH_TUNNEL only: MYSQL_HOST=127.0.0.1, MYSQL_PORT=13306 (match profile.ssh.localPort).
# Add reviewed profile.ssh from historical-recovery-ssh.example.json. TLS variables
# above apply only to TCP_PROXY; never weaken them to enable SSH mode.
R2_ACCOUNT_ID=YOUR_ACCOUNT
R2_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
R2_BUCKET_NAME=YOUR_ENVIRONMENT_BUCKET
R2_REGION=auto
R2_ACCESS_KEY_ID=YOUR_READ_ONLY_KEY
R2_SECRET_ACCESS_KEY=YOUR_READ_ONLY_SECRET
