# ============================================
# EDMS Frontend Environment
# ============================================

VITE_APP_NAME=APP-EDMS-SMPV
VITE_APP_VERSION=1.0.0

# API
VITE_API_BASE_URL=http://localhost:4000/api

# Environment
VITE_APP_ENV=development

# Demo utility
VITE_ENABLE_DEMO_RESET=true

# Development mock email
VITE_ENABLE_MOCK_EMAIL=true

# Mock API //ubah nilai menjadi false jika ingin menggunakan API asli
VITE_USE_MOCK_API=true
